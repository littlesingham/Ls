# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here_from_botfather

# JioTV Configuration
JIOTV_USERNAME=your_jio_mobile_number
JIOTV_API_BASE=https://jiotvapi.media.jio.com

# Recording Settings
RECORDINGS_DIR=./recordings
MAX_RECORDING_DURATION=3600
VIDEO_QUALITY=high

# Database
DATABASE_URL=sqlite:///./jiotv_bot.db

# Logging
LOG_LEVEL=INFO

# Bot Settings
ADMIN_USER_ID=your_user_id_here
MAX_CONCURRENT_RECORDINGS=2
